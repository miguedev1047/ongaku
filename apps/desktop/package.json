{
  "name": "ongaku",
  "version": "1.0.0",
  "description": "A simple mp3 music player",
  "homepage": "https://electron-vite.org",
  "author": "example.com",
  "main": "./out/main/index.js",
  "scripts": {
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run typecheck && electron-vite build && electron-builder --dir",
    "build:win": "npm run typecheck && electron-vite build && electron-builder --win",
    "build:mac": "npm run typecheck && electron-vite build && electron-builder --mac",
    "build:linux": "npm run typecheck && electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.0",
    "@tanstack/react-query-devtools": "^5.103.0",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-router-devtools": "^1.167.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "electron-updater": "^6.8.9",
    "music-metadata": "^11.15.0",
    "next-themes": "^0.4.6",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "virtua": "^0.51.3",
    "ytdlp-nodejs": "^3.4.5",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@ongaku/toolchain": "workspace:*",
    "@ongaku/server": "workspace:*",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxfmt": "^0",
    "oxlint": "^1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
