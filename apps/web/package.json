{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:sync": "bun ../../packages/assets/scripts/sync.mjs public logo",
    "dev": "bun run dev:web",
    "dev:web": "bun run assets:sync && vite dev --port 3000",
    "dev:all": "bun run dev:web",
    "generate-routes": "tsr generate",
    "build": "bun run assets:sync && vite build",
    "preview": "vite preview",
    "deploy": "bun run build && bunx wrangler deploy",
    "cf-typegen": "bunx wrangler types",
    "cf:dev": "bunx wrangler dev",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@animate-ui/react": "^2.0.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@ongaku/assets": "workspace:*",
    "@ongaku/ui": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "latest",
    "@tanstack/redact": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "i18next": "^26.4.2",
    "motion": "^14.6.0",
    "ogl": "^1.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@ongaku/config": "workspace:*",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.39",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.2",
    "vite": "^8",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
