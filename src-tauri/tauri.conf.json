{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ongaku",
  "version": "0.1.25",
  "identifier": "com.miguel-angel.ongaku",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ongaku",
        "width": 1080,
        "height": 720,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true
      },
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https://*.googlevideo.com https://*.youtube.com; img-src 'self' data: asset: https: https://asset.localhost http://127.0.0.1:* http://localhost:*; media-src 'self' asset: https://asset.localhost http://127.0.0.1:* http://localhost:* https://*.googlevideo.com https://*.youtube.com blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "apprun-hooks/wayland-compat.sh": "appimage/apprun-wayland-compat.sh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyMjYwQzNFRDk2MzMzQzIKUldUQ00yUFpQZ3dtVXNqUElJRngrUWhNeDBqbG9GODhDeTZFTE52a3ZZK1hyZ0paVWhDOERMVXEK",
      "endpoints": [
        "https://github.com/miguedev1047/ongaku/releases/latest/download/latest.json"
      ]
    }
  }
}
