{
  "name": "ongaku-monorepo",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "turbo run dev:all --filter=desktop --filter=web",
    "dev:web": "turbo run dev:web --filter=web",
    "dev:tauri": "turbo run dev:tauri",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web...",
    "build:tauri": "turbo run build:tauri",
    "preview": "turbo run preview",
    "test": "turbo run test",
    "test:watch": "bun --filter desktop test:watch",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:platform": "turbo run check:platform",
    "tauri": "bun --filter desktop tauri",
    "tauri:dev": "turbo run dev:tauri",
    "tauri:build": "turbo run build:tauri"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "turbo": "^2.5.0"
  }
}
